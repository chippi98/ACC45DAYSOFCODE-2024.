#include <stdio.h>

#define MAX_SIZE 100

int main()
{
    int A[MAX_SIZE];
    int N, i, max= 0;
    int count[MAX_SIZE] = {0}; 
    
    printf("Enter the number of elements in the array: ");
    scanf("%d", &N);

    printf("Enter the elements of the array:\n");
    for (i = 0; i < N; i++)
    {
        scanf("%d", &A[i]);
        count[A[i]]++; 
    }

 
    for (i = 0; i < MAX_SIZE; i++) {
        if (count[i] > max)
        {
            max= count[i];
        }
    }


    int min = N - max;

    printf("Minimum operations required to make all elements same: %d\n", min);

    return 0;
}
